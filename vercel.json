{
  "builds": [
    {
      "src": "backend/app/vercel.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["backend/app/**"]
      }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/app/vercel.py"
    },
    {
      "src": "/(.*\\..*)",
      "dest": "frontend/dist/$1"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/dist/index.html"
    }
  ]
}
