{
  "builds": [
    {
      "src": "backend/app/vercel.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["backend/app/**"]
      }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/backend/app/vercel.py"
    },
    {
      "source": "/:path*\\.(js|css|png|jpg|jpeg|svg|ico|txt|webp|woff2|woff|ttf|map)",
      "destination": "/frontend/dist/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/frontend/dist/index.html"
    }
  ]
}
